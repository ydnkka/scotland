\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces  \textbf  {Summary of the EpiLink-derived SSE transition graph.} Node counts refer to window-level temporal cluster nodes. The eligible background is restricted to non-candidate nodes with cluster size at least as large as the smallest candidate node. }}{3}{table.caption.5}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:sse_summary}{{1}{3}{\textbf {Summary of the EpiLink-derived SSE transition graph.} Node counts refer to window-level temporal cluster nodes. The eligible background is restricted to non-candidate nodes with cluster size at least as large as the smallest candidate node}{table.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces  \textbf  {Example EpiLink-derived transition subgraph.} Window-level cluster nodes are connected across adjacent surveillance windows, allowing local amplification, persistence, and onward dissemination signatures to be evaluated as temporal graph properties rather than as static cluster-size summaries. }}{4}{figure.caption.6}\protected@file@percent }
\newlabel{fig:sse_framework}{{1}{4}{\textbf {Example EpiLink-derived transition subgraph.} Window-level cluster nodes are connected across adjacent surveillance windows, allowing local amplification, persistence, and onward dissemination signatures to be evaluated as temporal graph properties rather than as static cluster-size summaries}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces  \textbf  {Candidate nodes occupy a distinct local-growth and onward-spread metric space.} Each point is a window-level cluster node, positioned by its local growth/novelty score and onward-spread score, sized by cluster size and coloured by graph role, and split by whether it passed the candidate screen. Candidates separate from background nodes across graph roles rather than along a single size axis. }}{5}{figure.caption.8}\protected@file@percent }
\newlabel{fig:metric_space}{{2}{5}{\textbf {Candidate nodes occupy a distinct local-growth and onward-spread metric space.} Each point is a window-level cluster node, positioned by its local growth/novelty score and onward-spread score, sized by cluster size and coloured by graph role, and split by whether it passed the candidate screen. Candidates separate from background nodes across graph roles rather than along a single size axis}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces  \textbf  {Candidate SSE graph phenotypes.} Candidate nodes separate into interpretable combinations of local amplification, persistence, branching, onward dissemination, and population-mixing signatures. }}{6}{figure.caption.10}\protected@file@percent }
\newlabel{fig:sse_categories}{{3}{6}{\textbf {Candidate SSE graph phenotypes.} Candidate nodes separate into interpretable combinations of local amplification, persistence, branching, onward dissemination, and population-mixing signatures}{figure.caption.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces  \textbf  {Primary association results for candidate SSE membership.} Composition models use sequence-window rows joined to eligible-node candidate status and adjust for surveillance window and clade. Node-mixing models use eligible nodes and entropy features standardised against size-window null models. Policy and vaccination rows are included as contextual analyses, not causal effects. }}{7}{table.caption.12}\protected@file@percent }
\newlabel{tab:association_summary}{{2}{7}{\textbf {Primary association results for candidate SSE membership.} Composition models use sequence-window rows joined to eligible-node candidate status and adjust for surveillance window and clade. Node-mixing models use eligible nodes and entropy features standardised against size-window null models. Policy and vaccination rows are included as contextual analyses, not causal effects}{table.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces  \textbf  {Primary and expanded association evidence.} Omnibus Wald tests compare candidate and eligible background nodes across composition and node-mixing model families. Geographic composition variables show the strongest and most consistent evidence. }}{7}{figure.caption.13}\protected@file@percent }
\newlabel{fig:association_heatmap}{{4}{7}{\textbf {Primary and expanded association evidence.} Omnibus Wald tests compare candidate and eligible background nodes across composition and node-mixing model families. Geographic composition variables show the strongest and most consistent evidence}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces  \textbf  {Geographic enrichment of candidate-node sequence membership.} Adjusted odds ratios highlight enrichment in remote, island, and selected non-metropolitan contexts relative to the primary urban and health-board reference categories. }}{8}{figure.caption.14}\protected@file@percent }
\newlabel{fig:geographic_enrichment}{{5}{8}{\textbf {Geographic enrichment of candidate-node sequence membership.} Adjusted odds ratios highlight enrichment in remote, island, and selected non-metropolitan contexts relative to the primary urban and health-board reference categories}{figure.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces  \textbf  {Sensitivity of association evidence across model specifications.} The sensitivity matrix compares the main association signals across primary, expanded, clade-stratified, window-adjusted, and entropy-scale sensitivity analyses. }}{9}{figure.caption.17}\protected@file@percent }
\newlabel{fig:clade_sensitivity}{{6}{9}{\textbf {Sensitivity of association evidence across model specifications.} The sensitivity matrix compares the main association signals across primary, expanded, clade-stratified, window-adjusted, and entropy-scale sensitivity analyses}{figure.caption.17}{}}
