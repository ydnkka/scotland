# Git LFS for large generated analysis artifacts
# Keep code, notebooks, configs, and small text outputs in normal git.
analysis/**/*.parquet filter=lfs diff=lfs merge=lfs -text
analysis/**/*.csv filter=lfs diff=lfs merge=lfs -text
analysis/**/*.pdf filter=lfs diff=lfs merge=lfs -text
analysis/**/*.png filter=lfs diff=lfs merge=lfs -text
analysis/**/*.svg filter=lfs diff=lfs merge=lfs -text
analysis/**/*.eps filter=lfs diff=lfs merge=lfs -text
analysis/**/*.tif filter=lfs diff=lfs merge=lfs -text
